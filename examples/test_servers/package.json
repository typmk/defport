{
  "name": "defport-mcp-test-servers",
  "version": "1.0.0",
  "description": "Test MCP servers for defport - JVM and Node.js implementations",
  "main": "target/mcp_test_server_node.js",
  "scripts": {
    "build": "shadow-cljs compile node-server",
    "build:release": "shadow-cljs release node-server",
    "watch": "shadow-cljs watch node-server",
    "clean": "rm -rf target .shadow-cljs",
    "server": "node target/mcp_test_server_node.js",
    "server:http": "node target/mcp_test_server_node.js --http",
    "server:http:custom": "node target/mcp_test_server_node.js --http --port"
  },
  "keywords": [
    "mcp",
    "protocol",
    "server",
    "defport"
  ],
  "author": "defport",
  "license": "EPL-2.0",
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "shadow-cljs": "^2.28.0"
  }
}
