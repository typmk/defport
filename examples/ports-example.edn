{:desc "Port definitions for defport-based applications"

 ;; ============================================================================
 ;; CONVENTIONS
 ;; ============================================================================
 ;;
 ;; ABBREVIATIONS:
 ;;   :desc   = :description    :in    = :input-schema   :out  = :output-schema
 ;;   :fn     = :handler        :meta  = :metadata       :req  = :required
 ;;   :props  = :properties
 ;;
 ;; DEFAULTS (don't specify):
 ;;   :id          -> Inferred from map key
 ;;   :name        -> String of id ("search-code")
 ;;   :dangerous?  -> false
 ;;   :cacheable?  -> true (read-only ops)
 ;;   :protocols   -> #{:mcp :lsp :dap} (all)
 ;;   :token-budget -> 1000
 ;;
 ;; Progressive disclosure: simple → complex
 ;; ============================================================================

 :ports
 {
  ;; -------------------------------------------------------------------------
  ;; MINIMAL (4 lines) - description, schema, handler
  ;; -------------------------------------------------------------------------
  :search-code
  {:desc "Search for code by semantic similarity"
   :in   {:type "object" :props {:query {:type "string"}} :req ["query"]}
   :fn   my.app/search-code}

  ;; -------------------------------------------------------------------------
  ;; WITH OUTPUT SCHEMA
  ;; -------------------------------------------------------------------------
  :find-callers
  {:desc "Find all functions that call the target"
   :in   {:type "object"
          :props {:function-name {:type "string"}
                  :limit {:type "integer" :default 50}}
          :req ["function-name"]}
   :out  {:type "array" :items {:type "string"}}
   :fn   my.app/find-callers}

  ;; -------------------------------------------------------------------------
  ;; WITH METADATA
  ;; -------------------------------------------------------------------------
  :analyze-complexity
  {:desc "Analyze cyclomatic complexity of code"
   :in   {:type "object" :props {:file-path {:type "string"}} :req ["file-path"]}
   :fn   my.app/analyze-complexity
   :meta {:token-budget 2000
          :pipeline :analysis-pipeline}}

  ;; -------------------------------------------------------------------------
  ;; DANGEROUS (modifies files)
  ;; -------------------------------------------------------------------------
  :rename-function
  {:desc "Rename a function across the codebase"
   :in   {:type "object"
          :props {:old-name {:type "string"}
                  :new-name {:type "string"}
                  :dry-run {:type "boolean" :default true}}
          :req ["old-name" "new-name"]}
   :out  {:type "object" :props {:files-changed {:type "integer"}}}
   :fn   my.app/rename-function
   :meta {:dangerous? true
          :requires-approval? true
          :requires-clean-git? true}}

  ;; -------------------------------------------------------------------------
  ;; PROTOCOL-SPECIFIC
  ;; -------------------------------------------------------------------------
  :navigate-url
  {:desc "Navigate browser to URL (CDP)"
   :in   {:type "object" :props {:url {:type "string"}} :req ["url"]}
   :fn   scout.impl/navigate
   :meta {:protocols #{:cdp} :timeout-ms 30000}}

  :code-completion
  {:desc "Provide code completion suggestions"
   :in   {:type "object"
          :props {:text-document {:type "object"}
                  :position {:type "object"}}
          :req ["text-document" "position"]}
   :fn   my.lsp/completion
   :meta {:protocols #{:lsp}
          :capability "textDocument/completion"
          :trigger-characters ["." ":" "/"]}}}}