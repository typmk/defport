{:paths ["src" "resources"]

 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
        org.clojure/core.async {:mvn/version "1.8.741"}
        ;; malli removed for faster startup - using inline validation
        cheshire/cheshire {:mvn/version "6.2.0"}
        http-kit/http-kit {:mvn/version "2.8.1"}}

 :aliases
 {:kaocha {:extra-paths ["test"]
           :extra-deps {org.clojure/test.check {:mvn/version "1.1.1"}
                        lambdaisland/kaocha {:mvn/version "1.91.1392"}}
           :main-opts ["-m" "kaocha.runner"]}

  :test {:extra-paths ["test"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.1"}
                      lambdaisland/kaocha {:mvn/version "1.91.1392"}}}

  :examples {:extra-paths ["examples"]}

  :benchmark {:extra-paths ["test"]
              :extra-deps {criterium/criterium {:mvn/version "0.4.6"}
                           org.clojure/test.check {:mvn/version "1.1.1"}}
              :jvm-opts ["-Xmx2g" "-server"]}

  :build {:deps {io.github.clojure/tools.build {:git/tag "v0.10.14" :git/sha "1176afd"}}
          :ns-default build}

  ;; `clojure -M:cljs compile test` builds the .cljc surface for Node.
  ;; :extra-paths carries test/ — without it shadow cannot see the .cljc
  ;; tests and the build is a compile of src/ alone.
  ;;
  ;; ClojureScript is pinned here, not in :deps — nothing on the JVM or
  ;; babashka path needs it, and at top level it put the Closure compiler
  ;; on every consumer's classpath.
  :cljs {:extra-paths ["test"]
         :extra-deps {org.clojure/clojurescript {:mvn/version "1.12.145"}
                      thheller/shadow-cljs {:mvn/version "3.4.12"}
                      org.clojure/test.check {:mvn/version "1.1.1"}}
         :main-opts ["-m" "shadow.cljs.devtools.cli"]}}}
