 ;; Enums
 ;; ============================================================================

 :enums
 {:StopReason
  {:values ["step" "breakpoint" "exception" "pause" "entry" "goto"
            "function breakpoint" "data breakpoint" "instruction breakpoint"]}

  :ThreadReason
  {:values ["started" "exited"]}

  :OutputCategory
  {:values ["console" "stdout" "stderr" "telemetry" "important"]}

  :BreakpointReason
  {:values ["changed" "new" "removed"]}

  :ModuleReason
  {:values ["new" "changed" "removed"]}

  :SourceReason
  {:values ["new" "changed" "removed"]}

  :EvaluateContext
  {:values ["watch" "repl" "hover" "clipboard" "variables"]}

  :VariablesFilter
  {:values ["indexed" "named"]}

  :DataBreakpointAccessType
  {:values ["read" "write" "readWrite"]}

  :SteppingGranularity
  {:values ["statement" "line" "instruction"]}

  :CompletionItemType
  {:values ["method" "function" "constructor" "field" "variable" "class"
